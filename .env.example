# Canonical site URL — used for metadata, sitemap.xml, robots.txt, and Open Graph tags.
# Set this to the real deployed URL (Vercel assigns one, or use a custom domain).
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app

# Contact form → Resend (see app/api/contact/route.ts). Get a free key at resend.com/api-keys.
# Without a verified sending domain, Resend's sandbox `onboarding@resend.dev` sender can only
# deliver to the email address your Resend account itself was created with.
RESEND_API_KEY=

# Optional: where contact-form submissions are sent. Defaults to data/site.ts's `email` if unset.
CONTACT_TO_EMAIL=
