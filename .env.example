# Canonical site URL — used for metadata, sitemap.xml, robots.txt, and Open Graph tags.
# Live site: https://nodirbekov.netlify.app (hosted on Netlify).
NEXT_PUBLIC_APP_URL=https://nodirbekov.netlify.app

# Contact form → Resend (see app/api/contact/route.ts). Get a free key at resend.com/api-keys.
# Without a verified sending domain, Resend's sandbox `onboarding@resend.dev` sender can only
# deliver to the email address your Resend account itself was created with.
RESEND_API_KEY=

# Optional: where contact-form submissions are sent. Defaults to data/site.ts's `email` if unset.
CONTACT_TO_EMAIL=

# GA4 Measurement ID (format: G-XXXXXXXXXX) from analytics.google.com — create a
# property there, then Admin → Data Streams → your web stream → Measurement ID.
# Leave unset locally: GoogleAnalytics.tsx renders nothing without it, so dev
# traffic never pollutes real analytics data. Set only in Netlify's env vars.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
